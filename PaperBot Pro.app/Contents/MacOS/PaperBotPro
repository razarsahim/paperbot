#!/bin/bash
# PaperBot Pro launcher — PAPER TRADING ONLY.
REPO="/Users/raza/paperbot"
LOG="$REPO/logs/launcher/menubar.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null
if /usr/bin/pgrep -f "$REPO/launcher/menubar.py" >/dev/null; then
  exit 0
fi
"$REPO/.venv/bin/python" "$REPO/launcher/menubar.py" >> "$LOG" 2>&1 &
wait $!
