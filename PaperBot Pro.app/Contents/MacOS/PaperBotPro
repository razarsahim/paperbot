#!/bin/bash
# PaperBot Pro launcher — PAPER TRADING ONLY. Runs the menu-bar controller
# from the project venv; all paths are absolute to this checkout.
REPO="/Users/raza/Downloads/crypto-paper-bot"
LOG="$REPO/logs/launcher/menubar.log"
mkdir -p "$(dirname "$LOG")"
# single-instance: if the menubar app is already running, just activate it
if pgrep -f "$REPO/launcher/menubar.py" >/dev/null; then
  exit 0
fi
exec "$REPO/.venv/bin/python" "$REPO/launcher/menubar.py" >> "$LOG" 2>&1
