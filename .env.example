# PAPER TRADING ONLY — no credentials required or supported.
PAPERBOT_EXCHANGE=kraken
PAPERBOT_SYMBOL=BTC/GBP
PAPERBOT_STARTING_BALANCE=1000
PAPERBOT_RISK_PER_TRADE=0.005
PAPERBOT_MAX_DAILY_DRAWDOWN=0.02
PAPERBOT_MAX_TOTAL_DRAWDOWN=0.05
PAPERBOT_FEE_RATE=0.004
PAPERBOT_SLIPPAGE_RATE=0.001
PAPERBOT_INTERVAL_SECONDS=60
# Alert if an open position's stop went unobserved for this many seconds.
PAPERBOT_MONITOR_GAP_SECONDS=300
# Optional alert sinks (alerts always also append to state/alerts.jsonl).
# PAPERBOT_WEBHOOK_URL=https://example.com/your-private-webhook
# PAPERBOT_DESKTOP_NOTIFY=1
